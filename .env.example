# Copy to app/web/.env.local and fill in locally. Never commit real values.
# All of these are read server-side only (Next.js route handlers). None may be NEXT_PUBLIC_.

# Account URL host, hyphens not underscores, e.g. <org>-<account>.snowflakecomputing.com
SNOWFLAKE_ACCOUNT_HOST=
# Two role-restricted programmatic access tokens, one per "Acting as" role.
# Mint them yourself in Snowsight (see docs/tether/BUILD-STATUS.md); never paste them anywhere else.
SNOWFLAKE_PAT_AGENT=
SNOWFLAKE_PAT_CLINICIAN=
SNOWFLAKE_ROLE_AGENT=CARE_AGENT_ROLE
SNOWFLAKE_ROLE_CLINICIAN=CLINICIAN_ROLE
SNOWFLAKE_WAREHOUSE=DEFAULT_WH
SNOWFLAKE_DATABASE=CARE_RULES
SNOWFLAKE_SCHEMA=CORE
SNOWFLAKE_AGENT_NAME=TETHER_ASK

# Label written to audit rows for the clinician in the demo
APPROVER_LABEL=Dr. Example

# live | fixtures (live falls back to fixtures when the token for the acting role is missing)
DATA_MODE=fixtures
