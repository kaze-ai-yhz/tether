flowchart LR
  subgraph APP["Tether app · Next.js, local"]
    direction TB
    tabP["Patients tab"]:::doc
    tabR["Runbooks tab"]:::doc
    ask["Ask drawer"]:::doc
  end
  subgraph SF["Snowflake · database TETHER"]
    direction TB
    notes["NOTES<br/>synthetic SOAP notes, de-identified"]:::eng
    poolt["POOL<br/>guideline docs and chunks, doctor rules,<br/>runbooks per disease, action buckets"]:::eng
    search["Cortex Search<br/>over the pool"]:::eng
    run["RUN<br/>patients, cases, todos, monitor items,<br/>values, actions, audit"]:::eng
    procs["Stored procedures<br/>read plan, compose plan, tick clock,<br/>collect, evaluate, approve rule"]:::eng
    agent["Cortex Agent<br/>Analyst plus Search, read only"]:::eng
  end
  subgraph CL["Claude via Cortex AI functions"]
    direction TB
    opus["claude-opus-5-5<br/>compose plans, compile runbooks,<br/>learn doctor rules"]:::ai
    sonnet["claude-sonnet-5-5<br/>read AI Plan, parse guideline updates"]:::ai
  end
  subgraph ADP["Adapters · simulated today"]
    direction TB
    watch["Apple Watch sync"]:::ph
    dev["Home device"]:::ph
    phone["Phone call or SMS"]:::ph
    rx["Pharmacy and e-prescribing"]:::ph
  end
  tabP -->|"SQL API"| run
  tabR -->|"SQL API"| poolt
  ask -->|"Agent Run API"| agent
  notes --> procs
  procs --> opus
  procs --> sonnet
  poolt --> search --> procs
  procs --> run
  procs <--> ADP
  agent --> run
  agent --> search
